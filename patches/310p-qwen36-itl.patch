+@pytest.mark.parametrize('seed', [0, 1, 2])
+def test_wy_state_transform_applies_decay_once(seed):
+    """The state transform uses beta * exp(g), not beta * exp(2*g)."""
+    torch.manual_seed(seed)
+    q = torch.nn.functional.normalize(torch.randn(1, 64, 2, 16), dim=-1).half()
+    k = torch.nn.functional.normalize(torch.randn_like(q.float()), dim=-1).half()
+    v = torch.randn(1, 64, 2, 16).half()
+    g = -torch.rand(1, 64, 2) * 0.1
+    beta = torch.rand(1, 64, 2).half()
+    _, _, actual_w, actual_u, _ = _compute_kernel_inputs_from_torch_wy(q, k, v, g, beta, 64)
+
+    key = k.transpose(1, 2).double()
+    decay = g.transpose(1, 2).double().cumsum(-1)
+    beta_ref = beta.transpose(1, 2).double()
+    lower = (-(key * beta_ref[..., None]) @ key.transpose(-1, -2))
+    lower *= (decay[..., :, None] - decay[..., None, :]).exp()
+    lower = lower.tril(-1)
+    system = torch.eye(64) - lower
+    expected_w = torch.linalg.solve_triangular(
+        system, key * (beta_ref * decay.exp())[..., None], upper=False, unitriangular=True
+    ).half()
+    expected_u = torch.linalg.solve_triangular(
+        system, v.transpose(1, 2).double() * beta_ref[..., None], upper=False, unitriangular=True
+    ).half()
+    torch.testing.assert_close(actual_w, expected_w, atol=2e-4, rtol=2e-3)
+    torch.testing.assert_close(actual_u, expected_u, atol=2e-3, rtol=2e-3)
