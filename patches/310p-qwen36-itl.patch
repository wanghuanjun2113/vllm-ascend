--- /dev/null
+++ b/vllm-ascend/tools/itl20/wy_solve_310p/wy_solve.cpp
@@ -0,0 +1,87 @@
+#include "kernel_operator.h"
+
+using namespace AscendC;
+constexpr uint32_t kChunk = 64;
+constexpr uint32_t kElements = kChunk * kChunk;
+constexpr uint32_t kCores = 8;
+
+class WySolve {
+public:
+    __aicore__ inline void Init(GM_ADDR input, GM_ADDR output, uint32_t count) {
+        count_ = count;
+        input_.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(input), count * kElements);
+        output_.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(output), count * kElements);
+        pipe_.InitBuffer(matrix_, kElements * sizeof(float));
+        pipe_.InitBuffer(transposed_, kElements * sizeof(float));
+        pipe_.InitBuffer(scratch_, kElements * sizeof(float));
+        pipe_.InitBuffer(transposeOffsets_, kElements * sizeof(uint32_t));
+        pipe_.InitBuffer(columnOffsets_, kChunk * sizeof(uint32_t));
+        pipe_.InitBuffer(sums_, kChunk * 8 * sizeof(float));
+        pipe_.InitBuffer(row_, kChunk * sizeof(float));
+    }
+    __aicore__ inline void Process() {
+        auto matrix = matrix_.Get<float>();
+        auto transposed = transposed_.Get<float>();
+        auto scratch = scratch_.Get<float>();
+        auto transposeOffsets = transposeOffsets_.Get<uint32_t>();
+        auto columnOffsets = columnOffsets_.Get<uint32_t>();
+        auto sums = sums_.Get<float>();
+        auto resultRow = row_.Get<float>();
+        for (uint32_t i = 0; i < kChunk; ++i) {
+            columnOffsets.SetValue(i, i * kChunk * sizeof(float));
+            for (uint32_t j = 0; j < kChunk; ++j) {
+                transposeOffsets.SetValue(i * kChunk + j, (j * kChunk + i) * sizeof(float));
+            }
+        }
+        Sync<HardEvent::S_V>();
+        for (uint32_t index = GetBlockIdx(); index < count_; index += GetBlockNum()) {
+            const uint32_t offset = index * kElements;
+            DataCopy(matrix, input_[offset], kElements);
+            Sync<HardEvent::MTE2_V>();
+            Gather(transposed, matrix, transposeOffsets, 0, kElements);
+            PipeBarrier<PIPE_V>();
+            for (uint32_t row = 1; row < kChunk; ++row) {
+                // T[j,k] = B[k,j]; the original A[i,:] is broadcast across j.
+                Mul(scratch, transposed, matrix[row * kChunk], uint64_t(kChunk), uint8_t(kChunk),
+                    {1, 1, 1, 8, 8, 0});
+                PipeBarrier<PIPE_V>();
+                WholeReduceSum(sums, scratch, kChunk, kChunk, 1, 1, 8);
+                PipeBarrier<PIPE_V>();
+                Add(resultRow, matrix[row * kChunk], sums, kChunk);
+                PipeBarrier<PIPE_V>();
+                Scatter(transposed, resultRow, columnOffsets, row * sizeof(float), kChunk);
+                PipeBarrier<PIPE_V>();
+            }
+            Sync<HardEvent::V_S>();
+            for (uint32_t i = 0; i < kChunk; ++i) {
+                transposed.SetValue(i * kChunk + i, 1.0f);
+            }
+            Sync<HardEvent::S_V>();
+            Gather(matrix, transposed, transposeOffsets, 0, kElements);
+            Sync<HardEvent::V_MTE3>();
+            DataCopy(output_[offset], matrix, kElements);
+            Sync<HardEvent::MTE3_S>();
+        }
+    }
+private:
+    template <HardEvent kind> __aicore__ inline void Sync() {
+        const event_t event = static_cast<event_t>(pipe_.FetchEventID(kind));
+        SetFlag<kind>(event);
+        WaitFlag<kind>(event);
+    }
+    TPipe pipe_;
+    TBuf<TPosition::VECCALC> matrix_, transposed_, scratch_, transposeOffsets_, columnOffsets_, sums_, row_;
+    GlobalTensor<float> input_, output_;
+    uint32_t count_;
+};
+
+extern "C" __global__ __aicore__ void wy_solve_kernel(GM_ADDR input, GM_ADDR output, uint32_t count) {
+    WySolve op;
+    op.Init(input, output, count);
+    op.Process();
+}
+
+extern "C" void launch_wy_solve(void *input, void *output, uint32_t count, void *stream) {
+    const uint32_t blocks = count < kCores ? count : kCores;
+    wy_solve_kernel<<<blocks, nullptr, stream>>>((GM_ADDR)input, (GM_ADDR)output, count);
+}
