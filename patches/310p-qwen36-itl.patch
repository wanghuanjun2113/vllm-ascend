@@ -0,0 +1,37 @@
+import hashlib
+import tempfile
+import unittest
+from pathlib import Path
+
+from verify import identify
+
+
+class VerifyTests(unittest.TestCase):
+    def test_known_states_and_mixed_changes(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            entries = {
+                name: {
+                    state: hashlib.sha256((name + state).encode()).hexdigest()
+                    for state in ("clean", "baseline", "optimized")
+                }
+                for name in ("a.py", "b.py")
+            }
+            for state in ("clean", "baseline", "optimized"):
+                for name in entries:
+                    (root / name).write_text(name + state)
+                self.assertEqual(identify(root, entries), state)
+            (root / "a.py").write_text("a.pyclean")
+            self.assertEqual(identify(root, entries), "unknown")
+            (root / "a.py").unlink()
+            self.assertEqual(identify(root, entries), "unknown")
+
+    def test_unrecognized_content(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            (root / "a.py").write_text("unrelated edits")
+            self.assertEqual(identify(root, {"a.py": {"clean": "wrong"}}), "unknown")
+
+
+if __name__ == "__main__":
+    unittest.main()
