@@ -0,0 +1,35 @@
+#include <ATen/ATen.h>
+#include <torch/library.h>
+#include <torch_npu/csrc/core/npu/NPUStream.h>
+#include <torch_npu/csrc/framework/OpCommand.h>
+
+extern "C" void launch_wy_solve(void *, void *, uint32_t, void *);
+
+at::Tensor wy_solve(const at::Tensor &input) {
+    TORCH_CHECK(input.scalar_type() == at::kFloat, "WY solve requires float32");
+    TORCH_CHECK(input.dim() >= 2 && input.size(-1) == 64 && input.size(-2) == 64,
+                "WY solve requires [..., 64, 64]");
+    TORCH_CHECK(input.is_contiguous(), "WY solve requires contiguous input");
+    auto output = at::empty_like(input);
+    const uint32_t count = input.numel() / (64 * 64);
+    if (count == 0) return output;
+    void *stream = c10_npu::getCurrentNPUStream().stream();
+    at_npu::native::OpCommand command;
+    command.Name("WySolve310p");
+    command.SetCustomHandler([input, output, count, stream]() -> int {
+        launch_wy_solve(input.data_ptr(), output.data_ptr(), count, stream);
+        return 0;
+    });
+    command.Run();
+    return output;
+}
+
+TORCH_LIBRARY(vllm_ascend_perf, m) {
+    m.def("wy_solve(Tensor input) -> Tensor");
+}
+TORCH_LIBRARY_IMPL(vllm_ascend_perf, PrivateUse1, m) {
+    m.impl("wy_solve", &wy_solve);
+}
+TORCH_LIBRARY_IMPL(vllm_ascend_perf, Meta, m) {
+    m.impl("wy_solve", [](const at::Tensor &input) { return at::empty_like(input); });
+}
