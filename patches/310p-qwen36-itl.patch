+#!/usr/bin/env bash
+set -euo pipefail
+
+if [[ $# != 1 || ! -d "$1/vllm_ascend" ]]; then
+    echo "Usage: bash install_kernel.sh /path/to/vllm-ascend" >&2
+    exit 2
+fi
+: "${ASCEND_HOME_PATH:?Source the CANN environment before building}"
+kit=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
+target=$(cd -- "$1" && pwd)
+source_dir="$kit/wy_solve_310p"
+cmake -S "$source_dir" -B "$source_dir/build" -DCMAKE_BUILD_TYPE=Release \
+    -DCMAKE_ASC_ARCHITECTURES=dav-2002 -DASCEND_COMPUTE_UNIT=ascend310p
+cmake --build "$source_dir/build" -j 8
+python3 "$source_dir/build_extension.py"
+mkdir -p "$target/vllm_ascend/_wy_solve"
+install -m 755 "$source_dir/build_torch/libwy_solve_kernel.so" \
+    "$target/vllm_ascend/_wy_solve/libwy_solve_kernel.so"
+install -m 755 "$source_dir/build_torch/wy_solve_bindings.so" \
+    "$target/vllm_ascend/_wy_solve/wy_solve_bindings.so"
+echo "Installed WY libraries in $target/vllm_ascend/_wy_solve"
