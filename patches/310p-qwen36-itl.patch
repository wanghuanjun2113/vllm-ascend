+"""Read-only, byte-level preflight for the supported source states."""
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+
+def identify(root, entries):
+    states = None
+    for name, expected in entries.items():
+        path = root / name
+        if not path.is_file():
+            return "unknown"
+        digest = hashlib.sha256(path.read_bytes()).hexdigest()
+        matches = {state for state, value in expected.items() if value == digest}
+        states = matches if states is None else states & matches
+    for state in ("optimized", "baseline", "clean"):
+        if states and state in states:
+            return state
+    return "unknown"
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--ascend", type=Path, required=True)
+    parser.add_argument("--vllm", type=Path, required=True)
+    args = parser.parse_args()
+    manifest = json.loads(Path(__file__).with_name("manifest.json").read_text())
+    ascend_state = identify(args.ascend, manifest["vllm_ascend"])
+    vllm_state = identify(args.vllm, manifest["vllm"])
+    print(f"vllm-ascend: {ascend_state}; vllm: {vllm_state}")
+    if "unknown" in (ascend_state, vllm_state):
+        parser.exit(
+            2, "Source differs from supported states; do not force-apply patches.\n"
+        )
+
+
+if __name__ == "__main__":
+    main()
