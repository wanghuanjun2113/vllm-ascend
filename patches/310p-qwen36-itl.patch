@@ -0,0 +1,48 @@
+import json
+import time
+from pathlib import Path
+
+import torch
+import torch_npu
+import vllm_ascend  # noqa: F401 - register the same NPU operators as the serving process
+
+torch.set_num_threads(1)
+torch.npu.set_device(0)
+torch_npu.npu.set_compile_mode(jit_compile=False)
+root = Path(__file__).resolve().parent
+torch.ops.load_library(str(root / "build_torch/wy_solve_bindings.so"))
+results = []
+for n, kind in [
+    (1, "random"),
+    (12, "random"),
+    (1536, "random"),
+    (12, "zero"),
+    (12, "collinear"),
+]:
+    torch.manual_seed(42)
+    a = (torch.randn(n, 64, 64) * 0.03).tril(-1)
+    if kind == "zero":
+        a.zero_()
+    if kind == "collinear":
+        a = -torch.ones_like(a).tril(-1)
+    eye = torch.eye(64).expand(n, 64, 64).contiguous()
+    ref = torch.linalg.solve_triangular(
+        (eye - a).double(), eye.double(), upper=False, unitriangular=True
+    ).float()
+    aa = a.npu()
+    out = torch.ops.vllm_ascend_perf.wy_solve(aa)
+    torch.npu.synchronize()
+    error = float((out.cpu() - ref).abs().max())
+    torch.testing.assert_close(out.cpu(), ref, atol=2e-6, rtol=2e-5)
+    torch.testing.assert_close(aa.cpu(), a)
+    times = []
+    for _ in range(3):
+        t = time.perf_counter()
+        out = torch.ops.vllm_ascend_perf.wy_solve(aa)
+        torch.npu.synchronize()
+        times.append((time.perf_counter() - t) * 1000)
+    row = {"matrices": n, "kind": kind, "max_abs_error": error, "time_ms": times}
+    results.append(row)
+    print(row, flush=True)
+(root / "kernel_test.json").write_text(json.dumps(results, indent=2))
+print("ALL_KERNEL_TESTS_PASSED", flush=True)
